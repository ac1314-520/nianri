<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.NianRi.Base" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:colorAccent">@color/cinnabar</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/paper</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:datePickerDialogTheme">@style/Theme.NianRi.Picker</item>
        <item name="android:timePickerDialogTheme">@style/Theme.NianRi.Picker</item>
        <item name="android:alertDialogTheme">@style/Theme.NianRi.Dialog</item>
    </style>

    <style name="Theme.NianRi" parent="Theme.NianRi.Base" />

    <style name="Theme.NianRi.Picker" parent="@android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:colorAccent">@color/cinnabar</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.NianRi.Dialog" parent="@android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:colorAccent">@color/cinnabar</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimAmount">0.35</item>
    </style>

</resources>
